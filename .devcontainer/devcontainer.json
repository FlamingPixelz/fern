{
	"name": "react-dev",

	"build": {
		"dockerfile": "Dockerfile"
	},

	"workspaceFolder": "/workspace",

	"mounts": ["source=${localWorkspaceFolder},target=/workspace,type=bind"],

	"forwardPorts": [3000],

	"postCreateCommand": "npm install",

	"customizations": {
		"vscode": {
			"extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
		}
	}
}
